<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ToolboxPortal.styles.css"]" />
    <link rel="stylesheet" href="css/toolbox.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <div id="components-reconnect-modal">
        <div class="reconnect-box">
            Verbindung zum Server wird wiederhergestellt...
        </div>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.addEventListener("DOMContentLoaded", () => {
        const modal = document.getElementById("components-reconnect-modal");

        if (!modal) {
        return;
        }

        let reconnectTimer = null;

        const reloadPage = () => {
        console.warn("Blazor-Verbindung nicht stabil. Seite wird neu geladen...");
        window.location.reload();
        };

        const observer = new MutationObserver(() => {
        const isReconnecting =
        modal.classList.contains("components-reconnect-show");

        const hasFailed =
        modal.classList.contains("components-reconnect-failed")
        || modal.classList.contains("components-reconnect-rejected");

        if (isReconnecting) {
        console.warn("Blazor-Verbindung getrennt. Reconnect läuft...");

        clearTimeout(reconnectTimer);

        reconnectTimer = setTimeout(() => {
        reloadPage();
        }, 10000);
        }

        if (hasFailed) {
        clearTimeout(reconnectTimer);

        setTimeout(() => {
        reloadPage();
        }, 2000);
        }

        if (!isReconnecting && !hasFailed) {
        clearTimeout(reconnectTimer);
        }
        });

        observer.observe(modal, {
        attributes: true,
        attributeFilter: ["class"]
        });

        document.addEventListener("visibilitychange", () => {
        if (!document.hidden) {
        const isBroken =
        modal.classList.contains("components-reconnect-show")
        || modal.classList.contains("components-reconnect-failed")
        || modal.classList.contains("components-reconnect-rejected");

        if (isBroken) {
        reloadPage();
        }
        }
        });
        });
    </script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <script src="js/theme.js"></script>
    <script>
        window.loadTheme();
    </script>
    <script src="https://cdn.tiny.cloud/1/d7hxn8b5mh58d12zpynbysgdw78bszrwnekex9plifcbkhlg/tinymce/6/tinymce.min.js"></script>
    <script src="js/templateEditor.js"></script>
    
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
