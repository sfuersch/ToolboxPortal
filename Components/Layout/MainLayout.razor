@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using ToolboxPortal.Services

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ModuleAccessService ModuleAccessService

<div class="portal-shell" id="portalShell">
    <aside class="portal-sidebar">
        <div class="portal-brand">
            Toolbox Portal
        </div>

        <button class="sidebar-toggle" type="button" onclick="toggleSidebar()">
            ☰
        </button>

        <nav class="portal-nav">

            <AuthorizeView>

                <Authorized>

                    <div class="nav-section">
                        <div class="nav-section-title">
                            Allgemein
                        </div>

                        <NavLink href="/dashboard">
                            Dashboard
                        </NavLink>
                    </div>

                    @if (canAccessAi || canAccessThg || canAccessLeadOptimizer)
                    {
                        <div class="nav-section">
                            <div class="nav-section-title">
                                Tools
                            </div>

                            @if (canAccessAi)
                            {
                                <NavLink href="/tools/ai">
                                    KI Tools
                                </NavLink>
                            }

                            @if (canAccessThg)
                            {
                                <NavLink href="/tools/thg-followup">
                                    THG-Prämie Follow-up
                                </NavLink>
                            }

                            @if (canAccessLeadOptimizer)
                            {
                                <NavLink href="/tools/lead-optimizer">
                                    Lead Optimierung
                                </NavLink>
                            }
                        </div>
                    }

                    @if (isAdmin)
                    {
                        <div class="nav-section">
                            <div class="nav-section-title">
                                Administration
                            </div>

                            <NavLink href="/admin/users">
                                Benutzerverwaltung
                            </NavLink>
                        </div>
                    }

                    <div class="nav-section">
                        <div class="nav-section-title">
                            Konto
                        </div>

                        <NavLink href="/Account/Manage">
                            Profil
                        </NavLink>
                    </div>

                </Authorized>

                <NotAuthorized>

                    <div class="nav-section">

                        <NavLink href="/Account/Login">
                            Login
                        </NavLink>

                    </div>

                </NotAuthorized>

            </AuthorizeView>

        </nav>
    </aside>

    <main class="portal-main">
        <header class="portal-topbar">

            <button class="theme-toggle" onclick="toggleTheme()">
                Darkmode
            </button>

            <AuthorizeView>

                <Authorized>

                    <div class="user-menu">

                        <span class="user-name">
                            @context.User.Identity?.Name
                        </span>

                        <a href="/Account/Manage">
                            Profil
                        </a>

                        <form action="Account/Logout" method="post" class="logout-form">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="Account/Login" />

                            <button type="submit" class="logout-btn">
                                Logout
                            </button>
                        </form>

                    </div>

                </Authorized>

                <NotAuthorized>

                    <div class="user-menu">

                        <a href="/Account/Login">
                            Login
                        </a>

                    </div>

                </NotAuthorized>

            </AuthorizeView>

        </header>

        <section class="portal-content">
            @Body
        </section>
    </main>

    <script>
            window.loadSidebarState && window.loadSidebarState();
    </script>
</div>

@code {
    private bool canAccessAi;
    private bool canAccessThg;
    private bool canAccessLeadOptimizer;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var userId =
            authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        isAdmin = authState.User.IsInRole("Admin");

        canAccessAi = await ModuleAccessService.HasAccessAsync(
            userId,
            "ai-tool");

        canAccessThg = await ModuleAccessService.HasAccessAsync(
            userId,
            "thg-followup");

        canAccessLeadOptimizer = await ModuleAccessService.HasAccessAsync(
            userId,
            "lead-optimizer");
    }
}