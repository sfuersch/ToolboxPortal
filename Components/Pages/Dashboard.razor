@page "/dashboard"
@attribute [Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using ToolboxPortal.Data
@using ToolboxPortal.Services

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ModuleAccessService ModuleAccessService

<PageTitle>Dashboard</PageTitle>

<h1 class="page-title">Dashboard</h1>

<p class="page-subtitle">
    Wähle ein freigegebenes Tool aus.
</p>

<div class="tool-grid">

    @if (canAccessAi)
    {
        <div class="tool-card">
            <div class="tool-icon">🤖</div>

            <h3>KI Tools</h3>

            <p>Texte, Prompts und AI-Funktionen</p>

            <a class="btn btn-primary" href="/tools/ai">
                Öffnen
            </a>
        </div>
    }

    @if (canAccessThg)
    {
        <div class="tool-card">
            <div class="tool-icon">⚡</div>

            <h3>THG-Prämie Follow-up</h3>

            <p>Kundenimport, Mailversand und Registrierungsprüfung.</p>

            <a class="btn btn-primary" href="/tools/thg-followup">
                Öffnen
            </a>
        </div>
    }

    @if (!canAccessAi && !canAccessThg)
    {
        <div class="tool-card">
            <div class="tool-icon">🔒</div>

            <h3>Keine Tools freigegeben</h3>

            <p>Für deinen Benutzer wurden noch keine Module aktiviert.</p>
        </div>
    }

    @if (canAccessLeadOptimizer)
    {
        <div class="tool-card">
            <div class="tool-icon">🎯</div>

            <h3>Lead Optimierung</h3>

            <p>Leads aus mobile.de, Website und Kampagnen qualifizieren.</p>

            <a class="btn btn-primary" href="/tools/lead-optimizer">
                Öffnen
            </a>
        </div>
    }

</div>

@code {
    private bool canAccessAi;
    private bool canAccessThg;
    private bool canAccessLeadOptimizer;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var userId = UserManager.GetUserId(authState.User);

        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        var accessList = await ModuleAccessService.GetAccessesForUserAsync(userId);

        canAccessAi = accessList.Contains("ai-tool");
        canAccessThg = accessList.Contains("thg-followup");
        canAccessLeadOptimizer = accessList.Contains("lead-optimizer");
    }
}