@page "/tools/thg-followup"
@attribute [Authorize]

@using ToolboxPortal.Data
@using ToolboxPortal.Models
@using ToolboxPortal.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization

@inject ThgCsvImportService CsvImportService
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject EmailService EmailService
@inject ThgMailTemplateService TemplateService
@inject ThgFollowUpService FollowUpService
@inject ThgScrapingService ScrapingService
@inject IJSRuntime JS
@inject ThgInboxImportService InboxImportService
@inject ModuleAccessService ModuleAccessService
@inject NavigationManager Navigation

<PageTitle>THG-Prämie Follow-up Tool</PageTitle>

<h1 class="page-title">THG-Prämie Follow-up Tool</h1>

<p class="page-subtitle">
    Importiere E-Auto-Kunden, verwalte den Mailversand und prüfe später Registrierungen.
</p>

<div class="tool-tabs">
    <button class="tool-tab @(activeTab == "dashboard" ? "active" : "")"
            @onclick='() => SetActiveTab("dashboard")'>
        Dashboard
    </button>

    <button class="tool-tab @(activeTab == "customers" ? "active" : "")"
            @onclick='() => SetActiveTab("customers")'>
        Kunden
    </button>

    <button class="tool-tab @(activeTab == "templates" ? "active" : "")"
            @onclick='() => SetActiveTab("templates")'>
        Mailtemplates
    </button>

    <button class="tool-tab @(activeTab == "settings" ? "active" : "")"
            @onclick='() => SetActiveTab("settings")'>
        Einstellungen
    </button>
</div>
@if (activeTab == "dashboard")
{
    <div class="kpi-grid">

        <div class="kpi-card">
            <span>Gesamt</span>
            <strong>@totalCustomers</strong>
            <small>importierte Kunden</small>
        </div>

        <div class="kpi-card">
            <span>Offen</span>
            <strong>@openCustomers</strong>
            <small>kontaktierbar, nicht registriert</small>
        </div>

        <div class="kpi-card">
            <span>Registriert</span>
            <strong>@registeredCustomers</strong>
            <small>@conversionRate % Conversion</small>
        </div>

        <div class="kpi-card">
            <span>Ohne E-Mail</span>
            <strong>@noEmailCustomers</strong>
            <small>nicht kontaktierbar</small>
        </div>

        <div class="kpi-card">
            <span>Erstmails</span>
            <strong>@initialMailsSent</strong>
            <small>bereits versendet</small>
        </div>

        <div class="kpi-card">
            <span>Warten auf Erstmail</span>
            <strong>@waitingForInitialMail</strong>
            <small>neu importierte Kunden</small>
        </div>

        <div class="kpi-card">
            <span>Letzte Automatik</span>
            <strong>
                @(lastAutomationRunDate == null
                    ? "Nie"
                    : lastAutomationRunDate.Value.ToLocalTime().ToString("dd.MM. HH:mm"))
            </strong>
            <small>letzter Hintergrundlauf</small>
        </div>

    </div>
}
@if (activeTab == "customers")
{
    <div class="tool-card">
        <h3>CSV-Import</h3>

        <p>
            Lade die BEV-Zulassungsdatei hoch. Bestehende Kunden werden anhand der Fahrgestellnummer übersprungen.
        </p>

        <InputFile OnChange="ImportCsv" accept=".csv" />

        @if (!string.IsNullOrWhiteSpace(importMessage))
        {
            <p class="import-message">@importMessage</p>
        }
    </div>

    <div class="tool-card mt-4">
        <div class="result-header">
            <h3>Mailversand</h3>
        </div>

        <p>
            Versendet Erstmails an neue offene Kunden mit gültiger E-Mail-Adresse.
        </p>

        <button class="btn btn-primary"
                @onclick="SendInitialMails"
                disabled="@isSendingMails">
            @(isSendingMails ? "Versende..." : "Offene Erstmails senden")
        </button>

        @if (!string.IsNullOrWhiteSpace(mailSendMessage))
        {
            <p class="import-message">@mailSendMessage</p>
        }

        
    </div>

    @if (customers.Any())
    {
        <div class="tool-card mt-4">
            <div class="result-header">
                <h3>Kunden</h3>
                <span class="user-name">
                    @filteredCustomers.Count von @customers.Count Einträgen
                </span>
            </div>

            <div class="table-toolbar">
                <input class="form-control"
                       placeholder="Nach Name, Firma, E-Mail, Kennzeichen oder VIN suchen..."
                       @bind="searchTerm"
                       @bind:event="oninput" />

                <select class="form-control status-filter"
                        @bind="statusFilter">
                    <option value="all">Alle Datensätze</option>
                    <option value="open">Nur offene</option>
                    <option value="done">Nur abgeschlossene</option>
                    <option value="noemail">Ohne E-Mail</option>
                </select>
            </div>

            @if (lastImportDate != null)
            {
                <p class="import-meta">
                    Letzter Import: @lastImportDate.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </p>
            }

            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Firma</th>
                            <th>E-Mail</th>
                            <th>Kennzeichen</th>
                            <th>VIN</th>
                            <th>EZ</th>
                            <th>Erstmail</th>
                            <th>Versendet</th>
                            <th>Status</th>
                            <th>Aktion</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var customer in filteredCustomers)
                        {
                            <tr>
                                <td>@customer.FirstName @customer.LastName</td>
                                <td>@customer.Company</td>
                                <td>
                                    @customer.Email
                                    @if (!string.IsNullOrWhiteSpace(customer.EmailSource))
                                    {
                                        <small class="table-muted">(@customer.EmailSource)</small>
                                    }
                                </td>
                                <td>@customer.LicensePlate</td>
                                <td>@customer.Vin</td>
                                <td>@customer.FirstRegistrationDate?.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @if (customer.InitialMailSent)
                                    {
                                        <span class="status-pill success">Gesendet</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill neutral">Offen</span>
                                    }
                                </td>
                                <td>
                                    @if (customer.InitialMailSentAt != null)
                                    {
                                        @customer.InitialMailSentAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    }
                                </td>
                                <td>
                                    @if (customer.IsRegistered)
                                    {
                                        <span class="status-pill success">Registriert</span>
                                    }
                                    else if (string.IsNullOrWhiteSpace(customer.Email))
                                    {
                                        <span class="status-pill warning">Keine E-Mail</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill neutral">Offen</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        @if (!customer.IsRegistered && !string.IsNullOrWhiteSpace(customer.Email))
                                        {
                                            <button class="copy-btn"
                                                    @onclick="() => SendInitialMailToCustomer(customer)"
                                                    disabled="@isSendingMails">
                                                Mail senden
                                            </button>
                                        }

                                        <button class="copy-btn"
                                                @onclick="() => ToggleHistory(customer.Id)">
                                            Verlauf
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            @if (expandedCustomerId == customer.Id)
                            {
                                <tr class="history-row">
                                    <td colspan="10">
                                        <div class="history-panel">
                                            @if (!currentMailLogs.Any())
                                            {
                                                <p class="table-muted">
                                                    Keine Versandhistorie vorhanden.
                                                </p>
                                            }
                                            else
                                            {
                                                @foreach (var log in currentMailLogs)
                                                {
                                                    <div class="mail-log-item">
                                                        <div class="mail-log-header">
                                                            <strong>@log.MailType</strong>
                                                            <span>@log.SentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                                        </div>

                                                        <div class="mail-log-status">
                                                            @if (log.Success)
                                                            {
                                                                <span class="status-pill success">Erfolgreich</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="status-pill warning">Fehler</span>
                                                            }
                                                        </div>

                                                        @if (!string.IsNullOrWhiteSpace(log.ErrorMessage))
                                                        {
                                                            <div class="mail-log-error">
                                                                @log.ErrorMessage
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (activeTab == "templates")
{
    <div class="tool-card">
        <div class="result-header">
            <h3>Mailtemplates</h3>
        </div>

        @if (selectedTemplate != null)
        {
            <div class="table-toolbar">
                <select class="form-control"
                        @bind="selectedTemplateId"
                        @bind:after="SelectTemplate">
                    @foreach (var template in templates)
                    {
                        <option value="@template.Id">
                            @template.Name
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Betreff</label>

                <input class="form-control"
                       @bind="selectedTemplate.Subject" />
            </div>

            <div class="form-group">
                <label>HTML-Inhalt</label>

                <div class="editor-toolbar">
                    <button type="button"
                            class="copy-btn"
                            @onclick="ToggleEditorMode">
                        @(useVisualEditor ? "HTML-Modus" : "Visueller Editor")
                    </button>
                </div>

                @if (useVisualEditor)
{
    <textarea @key="visualEditorKey"
              id="template-editor"></textarea>
}
else
{
    <textarea @key="htmlEditorKey"
              class="form-control"
              rows="16"
              @bind="selectedTemplate.HtmlBody"></textarea>
}
                </div>

                <div class="tool-card mb-3">
                    <strong>Verfügbare Variablen</strong>

                    <div class="template-vars">
                        <code>{{Anrede}}</code>
                        <code>{{Vorname}}</code>
                        <code>{{Nachname}}</code>
                        <code>{{Firma}}</code>
                        <code>{{Email}}</code>
                        <code>{{Kennzeichen}}</code>
                        <code>{{VIN}}</code>
                        <code>{{Erstzulassung}}</code>
                        <code>{{THGLink}}</code>
                    </div>
                </div>

                <button class="btn btn-primary"
                        @onclick="SaveTemplate">
                    Template speichern
                </button>

                <div class="testmail-box">
                    <input class="form-control"
                           placeholder="Testmail-Adresse"
                           @bind="testEmail"
                           @bind:event="oninput" />

                    <button class="btn btn-primary"
                            @onclick="SendTestEmail">
                        Gewähltes Template senden
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(testMailMessage))
                {
                    <p class="import-message">@testMailMessage</p>
                }

                @if (!string.IsNullOrWhiteSpace(templateMessage))
                {
                    <p class="import-message">@templateMessage</p>
                }
            }
        else
            {
                <p class="table-muted">Keine Templates vorhanden.</p>
            }
        </div>
    }


@if (activeTab == "settings")
{
    <div class="tool-card">

        <div class="result-header">
            <h3>Follow-up Einstellungen</h3>
        </div>

        @if (followUpSettings != null)
        {
            <div class="tool-card mb-4">
                <h4>Wartungsmodus</h4>

                <label class="remember-me">
                    <InputCheckbox @bind-Value="followUpSettings.AutomationPaused" />
                    Automatik pausieren
                </label>

                <p class="table-muted">
                    Wenn aktiv, werden Postfach-Import, Registrierungsprüfung, Erstmailversand und Follow-ups nicht automatisch ausgeführt.
                </p>

                <button class="btn btn-primary"
                        @onclick="SaveFollowUpSettings">
                    Wartungsmodus speichern
                </button>
            </div>

            <h4>Follow-up Regeln</h4>

           

            <div class="settings-grid">
                <div class="form-group">
                    <label>Follow-up 1 nach Tagen</label>
                    <InputNumber class="form-control"
                                 @bind-Value="followUpSettings.FollowUp1AfterDays" />
                </div>

                <div class="form-group">
                    <label>Follow-up 2 nach Tagen</label>
                    <InputNumber class="form-control"
                                 @bind-Value="followUpSettings.FollowUp2AfterDays" />
                </div>

                <div class="form-group">
                    <label>Follow-up 3 nach Tagen</label>
                    <InputNumber class="form-control"
                                 @bind-Value="followUpSettings.FollowUp3AfterDays" />
                </div>

                <div class="form-group">
                    <label>Maximale Follow-ups</label>
                    <InputNumber class="form-control"
                                 @bind-Value="followUpSettings.MaxFollowUps" />
                </div>
            </div>

            <div class="form-group">
                <label>Benachrichtigungs-E-Mail bei Fehlern / Sicherheitsabfrage</label>
                <InputText class="form-control"
                           @bind-Value="followUpSettings.NotificationEmail"
                           placeholder="z. B. info@autohaus.de" />
            </div>

            <button class="btn btn-primary"
                    @onclick="SaveFollowUpSettings">
                Follow-up Regeln speichern
            </button>

            <hr />

            <h4>Manuelle Aktionen</h4>

            <div class="tool-card mb-3">
                <h5>Follow-up Lauf</h5>

                <p class="table-muted">
                    Prüft alle offenen Kunden und sendet fällige Erstmails oder Follow-ups anhand der gespeicherten Regeln.
                </p>

                <button class="btn btn-primary"
                        @onclick="RunFollowUps"
                        disabled="@isRunningFollowUps">
                    @(isRunningFollowUps ? "Prüfe..." : "Follow-ups jetzt prüfen")
                </button>

                @if (!string.IsNullOrWhiteSpace(followUpRunMessage))
                {
                    <p class="import-message">@followUpRunMessage</p>
                }
            </div>

            <div class="tool-card mb-3">
                <h5>Scraping-Test</h5>

                <p class="table-muted">
                    Testet, ob die THG-Plattform erreichbar ist und keine Sicherheitsabfrage erscheint.
                </p>

                <button class="btn btn-primary"
                        @onclick="RunScrapingHealthCheck"
                        disabled="@isRunningScrapingCheck">
                    @(isRunningScrapingCheck ? "Prüfe..." : "Scraping-Test starten")
                </button>

                @if (!string.IsNullOrWhiteSpace(scrapingCheckMessage))
                {
                    <p class="import-message">@scrapingCheckMessage</p>
                }
            </div>

            <div class="tool-card mb-3">
                <h5>Referral-Liste auslesen</h5>

                <p class="table-muted">
                    Liest die Referral-Liste aus und zeigt, wie viele Einträge gefunden wurden.
                </p>

                <button class="btn btn-primary"
                        @onclick="ReadReferralEntries"
                        disabled="@isReadingReferralEntries">
                    @(isReadingReferralEntries ? "Lese..." : "Referral-Liste auslesen")
                </button>

                @if (!string.IsNullOrWhiteSpace(referralReadMessage))
                {
                    <p class="import-message">@referralReadMessage</p>
                }
            </div>

            <div class="tool-card mb-3">
                <h5>Registrierungen abgleichen</h5>

                <p class="table-muted">
                    Vergleicht die Referral-Liste mit den importierten Kunden anhand des Namens und markiert Treffer als registriert.
                </p>

                <button class="btn btn-primary"
                        @onclick="CheckRegistrations"
                        disabled="@isCheckingRegistrations">
                    @(isCheckingRegistrations ? "Gleiche ab..." : "Registrierungen abgleichen")
                </button>

                @if (!string.IsNullOrWhiteSpace(registrationCheckMessage))
                {
                    <p class="import-message">@registrationCheckMessage</p>
                }
            </div>

            <hr />

            <h4>Automatisierung</h4>

            <div class="settings-grid">
                <div class="form-group">
                    <label class="remember-me">
                        <InputCheckbox @bind-Value="followUpSettings.AutoRegistrationCheckEnabled" />
                        Registrierungsprüfung automatisch ausführen
                    </label>
                </div>

                <div class="form-group">
                    <label>Automatik alle X Stunden</label>
                    <InputNumber class="form-control"
                                 @bind-Value="followUpSettings.BackgroundRunEveryHours" />
                </div>

                <div class="form-group">
                    <label>Max. Mails pro Lauf</label>
                    <InputNumber class="form-control"
                                 @bind-Value="followUpSettings.MaxMailsPerRun" />
                </div>
                <div class="form-group">
                    <label>Versand ab Uhrzeit</label>
                    <input class="form-control"
                           type="time"
                           value="@mailSendWindowStartText"
                           @onchange="OnMailSendWindowStartChanged" />
                </div>

                <div class="form-group">
                    <label>Versand bis Uhrzeit</label>
                    <input class="form-control"
                           type="time"
                           value="@mailSendWindowEndText"
                           @onchange="OnMailSendWindowEndChanged" />
                </div>
            </div>

            <div class="mt-4">
                <button class="btn btn-primary"
                        @onclick="SaveFollowUpSettings">
                    Automatisierung speichern
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(settingsMessage))
            {
                <p class="import-message">@settingsMessage</p>
            }

            <hr />

            <h4 class="mt-5">Postfach-Import</h4>

            <div class="tool-card mb-4">
                <div class="form-check mb-3">
                    <InputCheckbox @bind-Value="inboxSettings.IsEnabled"
                                   class="form-check-input" />

                    <label class="form-check-label">
                        Import aktivieren
                    </label>
                </div>

                <div class="settings-grid">
                    <div class="form-group">
                        <label>IMAP Host</label>
                        <InputText class="form-control"
                                   @bind-Value="inboxSettings.ImapHost" />
                    </div>

                    <div class="form-group">
                        <label>Port</label>
                        <InputNumber class="form-control"
                                     @bind-Value="inboxSettings.ImapPort" />
                    </div>

                    <div class="form-group">
                        <label class="remember-me">
                            <InputCheckbox @bind-Value="inboxSettings.UseSsl" />
                            SSL verwenden
                        </label>
                    </div>

                    <div class="form-group">
                        <label>Benutzername</label>
                        <InputText class="form-control"
                                   @bind-Value="inboxSettings.Username" />
                    </div>

                    <div class="form-group">
                        <label>Passwort</label>
                        <InputText type="password"
                                   class="form-control"
                                   @bind-Value="inboxSettings.Password" />
                    </div>

                    <div class="form-group">
                        <label>Erlaubter Absender</label>
                        <InputText class="form-control"
                                   @bind-Value="inboxSettings.AllowedSender" />
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button class="btn btn-primary"
                            @onclick="SaveInboxSettings">
                        Postfach speichern
                    </button>

                    <button class="btn btn-outline-secondary"
                            @onclick="TestInboxImport">
                        Jetzt testen
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(inboxStatus))
                {
                    <p class="import-message">@inboxStatus</p>
                }

                <div class="mt-4 small text-muted">
                    <div>
                        Letzter Check:
                        @(inboxSettings.LastCheckUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Noch nie")
                    </div>

                    <div>
                        Letzter Erfolg:
                        @(inboxSettings.LastSuccessUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Noch nie")
                    </div>

                    <div>
                        Letzter Fehler:
                        @(string.IsNullOrWhiteSpace(inboxSettings.LastError) ? "Keiner" : inboxSettings.LastError)
                    </div>
                </div>
            </div>
        }
        else
        {
            <p class="table-muted">
                Einstellungen werden geladen...
            </p>
        }
    </div>
}



@code {
    private string? currentUserId;
    private string importMessage = "";
    private string searchTerm = "";
    private string statusFilter = "all";
    private string testEmail = "";
    private string testMailMessage = "";
    private bool isSendingMails;
    private string mailSendMessage = "";
    private int? expandedCustomerId;
    private List<ThgMailTemplate> templates = new();
    private ThgMailTemplate? selectedTemplate;
    private int selectedTemplateId;
    private string templateMessage = "";
    private List<ThgMailLog> currentMailLogs = new();
    private string activeTab = "dashboard";
    private ThgFollowUpSettings? followUpSettings;
    private string settingsMessage = "";
    private List<ThgCustomer> customers = new();
    private bool isRunningFollowUps;
    private string followUpRunMessage = "";
    private bool isRunningScrapingCheck;
    private string scrapingCheckMessage = "";
    private bool isReadingReferralEntries;
    private string referralReadMessage = "";
    private bool isCheckingRegistrations;
    private string registrationCheckMessage = "";
    private int totalCustomers => customers.Count;
    private bool useVisualEditor = true;
    private int visualEditorKey = 0;
    private int htmlEditorKey = 0;
    private bool shouldInitEditor;
    private bool editorIsInitializing;
    private ThgInboxSettings inboxSettings = new();

    private string? inboxStatus;

    private int openCustomers =>
        customers.Count(x => !x.IsRegistered && !string.IsNullOrWhiteSpace(x.Email));

    private int registeredCustomers =>
        customers.Count(x => x.IsRegistered);

    private int noEmailCustomers =>
        customers.Count(x => string.IsNullOrWhiteSpace(x.Email));

    private int initialMailsSent =>
        customers.Count(x => x.InitialMailSent);

    private int waitingForInitialMail =>
    customers.Count(x =>
        !x.InitialMailSent
        && !x.IsRegistered
        && !string.IsNullOrWhiteSpace(x.Email));
        
        
    private double conversionRate =>
        totalCustomers == 0
            ? 0
            : Math.Round((double)registeredCustomers / totalCustomers * 100, 1);

    private DateTime? lastAutomationRunDate =>
        followUpSettings?.LastAutomationRunAt;

    private DateTime? lastImportDate =>
        customers.Any()
            ? customers.Max(x => x.CreatedAt)
            : null;

    private List<ThgCustomer> filteredCustomers =>
        customers
            .Where(x =>
                statusFilter == "all"
                || statusFilter == "open" && !x.IsRegistered && !string.IsNullOrWhiteSpace(x.Email)
                || statusFilter == "done" && x.IsRegistered
                || statusFilter == "noemail" && string.IsNullOrWhiteSpace(x.Email))
            .Where(x =>
                string.IsNullOrWhiteSpace(searchTerm)
                || $"{x.FirstName} {x.LastName} {x.Company} {x.Email} {x.LicensePlate} {x.Vin}"
                    .Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var user = await GetCurrentUser();

        if (user == null)
        {
            return;
        }

        var hasAccess = await ModuleAccessService.HasAccessAsync(
            user.Id,
            "thg-followup");

        if (!hasAccess)
        {
            Navigation.NavigateTo("/");
            return;
        }

        currentUserId = user.Id;

        await LoadCustomers();
        await LoadTemplates();
        await LoadFollowUpSettings();
        await LoadInboxSettings();
    }

    private string mailSendWindowStartText =>
    followUpSettings?.MailSendWindowStart.ToString(@"hh\:mm") ?? "08:00";

    private string mailSendWindowEndText =>
        followUpSettings?.MailSendWindowEnd.ToString(@"hh\:mm") ?? "18:00";

    private void OnMailSendWindowStartChanged(ChangeEventArgs e)
    {
        if (followUpSettings == null)
        {
            return;
        }

        var value = e.Value?.ToString();

        if (TimeSpan.TryParse(value, out var parsed))
        {
            followUpSettings.MailSendWindowStart = parsed;
        }
    }

    private void OnMailSendWindowEndChanged(ChangeEventArgs e)
    {
        if (followUpSettings == null)
        {
            return;
        }

        var value = e.Value?.ToString();

        if (TimeSpan.TryParse(value, out var parsed))
        {
            followUpSettings.MailSendWindowEnd = parsed;
        }
    }
    
    
    
    private async Task LoadInboxSettings()
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
