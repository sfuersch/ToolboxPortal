    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (editorIsInitializing)
        {
            return;
        }

        if (activeTab != "templates"
            || !useVisualEditor
            || selectedTemplate == null
            || !shouldInitEditor)
        {
            return;
        }

        editorIsInitializing = true;
        shouldInitEditor = false;

        try
        {
            await JS.InvokeVoidAsync(
                "templateEditor.init",
                "#template-editor",
                selectedTemplate.HtmlBody);
        }
        catch (Exception ex)
        {
            templateMessage = $"Editor konnte nicht geladen werden: {ex.Message}";
        }
        finally
        {
            editorIsInitializing = false;
        }
    }

    private async Task SetActiveTab(string tab)
    {
        if (activeTab == "templates" && useVisualEditor)
        {
            try
            {
                selectedTemplate!.HtmlBody =
                    await JS.InvokeAsync<string>(
                        "templateEditor.getContent",
                        "#template-editor");

                await JS.InvokeVoidAsync(
                    "templateEditor.destroy",
                    "#template-editor");
            }
            catch
            {
            }
        }

        activeTab = tab;

        if (activeTab == "templates" && useVisualEditor && selectedTemplate != null)
        {
            visualEditorKey++;
            shouldInitEditor = true;
        }
    }

    private async Task ToggleEditorMode()
    {
        if (selectedTemplate == null)
        {
            return;
        }

        if (useVisualEditor)
        {
            selectedTemplate.HtmlBody =
                await JS.InvokeAsync<string>(
                    "templateEditor.getContent",
                    "#template-editor");

            await JS.InvokeVoidAsync(
                "templateEditor.destroy",
                "#template-editor");

            useVisualEditor = false;
            htmlEditorKey++;
        }
        else
        {
            useVisualEditor = true;
            visualEditorKey++;
            shouldInitEditor = true;
        }
    }

    private async Task CheckRegistrations()
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }

        isCheckingRegistrations = true;

        try
        {
            var entries = await ScrapingService.GetReferralEntriesAsync();

            var referralNames = entries
                .Select(x => ScrapingService.NormalizeName(x.Name))
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToHashSet();

            var matched = 0;

            foreach (var customer in customers)
            {
                var customerName = ScrapingService.NormalizeName(
                    $"{customer.FirstName} {customer.LastName}");

                if (referralNames.Contains(customerName))
                {
                    customer.IsRegistered = true;
                    matched++;
                }
            }

            await DbContext.SaveChangesAsync();

            registrationCheckMessage =
                $"{matched} Kunden als registriert markiert. {entries.Count} Referral-Einträge geprüft.";

            await LoadCustomers();
        }
        catch (Exception ex)
        {
            registrationCheckMessage = $"Fehler bei der Registrierungsprüfung: {ex.Message}";
        }
        finally
        {
            isCheckingRegistrations = false;
        }
    }

    private async Task ImportCsv(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }

        var file = e.File;

        await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);

        var importedCustomers = await CsvImportService.ParseAsync(stream, currentUserId);

        var imported = 0;
        var skipped = 0;

        foreach (var customer in importedCustomers)
        {
            var exists = await DbContext.ThgCustomers
                .AnyAsync(x => x.UserId == currentUserId && x.Vin == customer.Vin);

            if (exists)
            {
                skipped++;
                continue;
            }

            DbContext.ThgCustomers.Add(customer);
            imported++;
        }

        await DbContext.SaveChangesAsync();

        importMessage = $"{imported} Kunden importiert, {skipped} Dubletten übersprungen.";

        await LoadCustomers();
    }

