    private async Task SendInitialMailToCustomer(ThgCustomer customer)
    {
        if (string.IsNullOrWhiteSpace(customer.Email))
        {
            mailSendMessage = "Dieser Kunde hat keine E-Mail-Adresse.";
            return;
        }

        if (customer.IsRegistered)
        {
            mailSendMessage = "Dieser Kunde ist bereits als registriert markiert.";
            return;
        }

        isSendingMails = true;

        try
        {
            var template = await TemplateService.GetTemplateAsync(currentUserId!, "Initial");

            var subject = template == null
                ? "Jetzt THG-Prämie für Ihr E-Auto sichern"
                : TemplateService.RenderTemplate(template.Subject, customer);

            var body = template == null
                ? $"<h2>Hallo {customer.FirstName},</h2><p>Sichern Sie sich jetzt Ihre THG-Prämie.</p>"
                : TemplateService.RenderTemplate(template.HtmlBody, customer);

            await EmailService.SendEmailAsync(customer.Email, subject, body);

            customer.InitialMailSent = true;
            customer.InitialMailSentAt = DateTime.UtcNow;
            customer.LastMailSentAt = DateTime.UtcNow;

            DbContext.ThgMailLogs.Add(new ThgMailLog
            {
                ThgCustomerId = customer.Id,
                RecipientEmail = customer.Email,
                MailType = "InitialManual",
                Subject = subject,
                SentAt = DateTime.UtcNow,
                Success = true
            });

            await DbContext.SaveChangesAsync();

            mailSendMessage = $"Mail an {customer.Email} wurde versendet.";

            await LoadCustomers();
        }
        catch (Exception ex)
        {
            DbContext.ThgMailLogs.Add(new ThgMailLog
            {
                ThgCustomerId = customer.Id,
                RecipientEmail = customer.Email,
                MailType = "InitialManual",
                Subject = "THG Erstmail",
                SentAt = DateTime.UtcNow,
                Success = false,
                ErrorMessage = ex.Message
            });

            await DbContext.SaveChangesAsync();

            mailSendMessage = $"Fehler beim Versand an {customer.Email}: {ex.Message}";
        }
        finally
        {
            isSendingMails = false;
        }
    }

    private async Task SendInitialMails()
    {
        isSendingMails = true;

        try
        {
            var template = await TemplateService.GetTemplateAsync(currentUserId!, "Initial");

            var openCustomers = customers
                .Where(x =>
                    !x.IsRegistered
                    && !x.InitialMailSent
                    && !string.IsNullOrWhiteSpace(x.Email))
                .ToList();

            var sent = 0;
            var failed = 0;

            foreach (var customer in openCustomers)
            {
                try
                {
                    var subject = template == null
                        ? "Jetzt THG-Prämie für Ihr E-Auto sichern"
                        : TemplateService.RenderTemplate(template.Subject, customer);

                    var body = template == null
                        ? $"<h2>Hallo {customer.FirstName},</h2><p>Sichern Sie sich jetzt Ihre THG-Prämie.</p>"
                        : TemplateService.RenderTemplate(template.HtmlBody, customer);

                    await EmailService.SendEmailAsync(customer.Email, subject, body);

                    customer.InitialMailSent = true;
                    customer.InitialMailSentAt = DateTime.UtcNow;
                    customer.LastMailSentAt = DateTime.UtcNow;

                    DbContext.ThgMailLogs.Add(new ThgMailLog
                    {
                        ThgCustomerId = customer.Id,
                        RecipientEmail = customer.Email,
                        MailType = "Initial",
                        Subject = subject,
                        SentAt = DateTime.UtcNow,
                        Success = true
                    });

                    sent++;
                }
                catch (Exception ex)
                {
                    DbContext.ThgMailLogs.Add(new ThgMailLog
                    {
                        ThgCustomerId = customer.Id,
                        RecipientEmail = customer.Email,
                        MailType = "Initial",
                        Subject = "THG Erstmail",
                        SentAt = DateTime.UtcNow,
                        Success = false,
                        ErrorMessage = ex.Message
                    });

                    failed++;
                }
            }

            await DbContext.SaveChangesAsync();

            mailSendMessage = $"{sent} Erstmails versendet, {failed} Fehler.";

            await LoadCustomers();
        }
        finally
        {
            isSendingMails = false;
        }
    }
