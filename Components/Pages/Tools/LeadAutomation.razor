            existing.UpdatedAt = DateTime.UtcNow;
        }

        await db.SaveChangesAsync();

        emailMessage = "Mail-Einstellungen gespeichert.";
    }
    
    private async Task ToggleSource(int sourceId)
    {
        using var scope = ScopeFactory.CreateScope();

        var db = scope.ServiceProvider
            .GetRequiredService<ApplicationDbContext>();

        var source = await db.LeadSources
            .FirstOrDefaultAsync(x => x.Id == sourceId);

        if (source == null)
        {
            return;
        }

        source.IsActive = !source.IsActive;

        await db.SaveChangesAsync();

        await LoadSources();
    }

    private async Task DeleteRule(int ruleId)
{
    using var scope = ScopeFactory.CreateScope();

    var db = scope.ServiceProvider
        .GetRequiredService<ApplicationDbContext>();

    var authState =
        await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var userId = await GetCurrentUserIdAsync();

        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

    var dbRule = await db.LeadAutomationRules
        .FirstOrDefaultAsync(x =>
            x.Id == ruleId &&
            x.UserId == userId);

    if (dbRule == null)
    {
        return;
    }

    if (dbRule.IsActive)
    {
        ruleMessage =
            "Aktive Regeln können nicht gelöscht werden. Bitte zuerst deaktivieren.";

        return;
    }

    db.LeadAutomationRules.Remove(dbRule);

    await db.SaveChangesAsync();

    ruleMessage = "Regel wurde gelöscht.";

    await LoadRules();
}
}