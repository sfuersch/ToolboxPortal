@page "/tools/lead-optimizer/automation"
@attribute [Authorize]

@using Microsoft.EntityFrameworkCore
@using ToolboxPortal.Data
@using ToolboxPortal.Models
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using ToolboxPortal.Services

@inject CurrentTenantService CurrentTenantService
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Lead Automationen</PageTitle>

<h1>Lead Automationen</h1>
<a class="btn btn-outline-secondary mb-3"
       href="/tools/lead-optimizer">
    ← Zurück zur Übersicht
</a><br />

<div class="tool-tabs">
    <button class="tool-tab @(activeTab == "task-rules" ? "active" : "")"
            @onclick='() => activeTab = "task-rules"'>

        Aufgabenregeln

    </button>

    <button class="tool-tab @(activeTab == "mail" ? "active" : "")"
            @onclick='() => SetActiveTab("mail")'>

        Mail-Automationen

    </button>
    <button class="tool-tab @(activeTab == "forms" ? "active" : "")"
            @onclick='() => SetActiveTab("forms")'>
        Formulare
    </button>
    <button class="tool-tab @(activeTab == "imports" ? "active" : "")"
            @onclick='() => activeTab = "imports"'>

        Importe

    </button>

    <button class="tool-tab @(activeTab == "exports" ? "active" : "")"
            @onclick='() => activeTab = "exports"'>

        Exporte / CRM

    </button>

    <button class="tool-tab">
        Scoring
    </button>

    <button class="tool-tab @(activeTab == "logs" ? "active" : "")"
            @onclick='() => SetActiveTab("logs")'>
        Logs
    </button>
</div>
@if (activeTab == "task-rules")

{

<div class="card p-4 mt-4">

    <h3 class="mb-4">
        Aufgabenregeln
    </h3>

    <div class="border rounded p-3 mb-4">

        <div class="row">

            <div class="col-md-4 mb-3">
                <label>Name</label>

                <input class="form-control"
                       @bind="newRule.Name" />
            </div>

            <div class="col-md-3 mb-3">
                <label>Trigger</label>

                <select class="form-select"
                        @bind="newRule.TriggerEvent">

                    <option>LeadCreated</option>
                    <option>LeadQualified</option>
                    <option>StatusChanged</option>
                    <option>TaskCompleted</option>

                </select>
            </div>
                <div class="col-md-3 mb-3">
                    <label>Aktion</label>

                    <select class="form-select"
                            @bind="newRule.ActionType">

                        <option value="CreateTask">
                            Aufgabe erstellen
                        </option>

                        <option value="SendQualificationMail">
                            Qualifizierungs-Mail senden
                        </option>

                    </select>
                </div>
                @if (newRule.ActionType == "CreateTask")
                {
                
                <div class="col-md-3 mb-3">
                <label>Priorität</label>

                <select class="form-select"
                        @bind="newRule.TaskPriority">

                    <option>High</option>
                    <option>Medium</option>
                    <option>Low</option>

                </select>
            </div>


            <div class="col-md-2 mb-3">
                <label>Delay Min.</label>

                <input type="number"
                       class="form-control"
                       @bind="newRule.DueOffsetMinutes" />
            </div>
                }
        </div>

            @if (newRule.ActionType == "CreateTask")

            {
        <div class="mb-3">
            <label>Aufgabe</label>

            <input class="form-control"
                   @bind="newRule.TaskTitle" />
        </div>

        <div class="mb-3">
            <label>Beschreibung</label>

            <textarea class="form-control"
                      rows="3"
                      @bind="newRule.TaskDescription"></textarea>
        </div>
            }
        <div class="d-flex gap-2">
            <button class="btn btn-primary"
                    @onclick="SaveRule">
                @(editingRuleId == null ? "Regel speichern" : "Änderungen speichern")
            </button>

            @if (editingRuleId != null)
            {
                <button class="btn btn-outline-secondary"
                        @onclick="CancelEdit">
                    Abbrechen
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(ruleMessage))
        {
            <div class="alert alert-info mt-3">
                @ruleMessage
            </div>
        }

    </div>

    @if (!rules.Any())
    {
        <p>
            Noch keine Regeln vorhanden.
        </p>
    }
    else
    {
        <table class="table">

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Trigger</th>
                    <th>Aktionstyp</th>
                    <th>Aufgabe</th>
                    <th>Priorität</th>
                    <th>Delay</th>
                    <th>Status</th>
                    <th>Aktion</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var rule in rules)
                {
                    <tr>

                        <td>@rule.Name</td>

                        <td>@rule.TriggerEvent</td>

                        <td>@rule.ActionType</td>

                        <td>@rule.TaskTitle</td>

                        <td>@rule.TaskPriority</td>

                        <td>@rule.DueOffsetMinutes Min.</td>

                        <td>

                            @if (rule.IsActive)
                            {
                                <span class="badge bg-success">
                                    Aktiv
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inaktiv
                                </span>
                            }

                        </td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="() => EditRule(rule.Id)">
                                    Bearbeiten
                                </button>

                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ToggleRule(rule.Id)">
                                    @(rule.IsActive ? "Deaktivieren" : "Aktivieren")
                                </button>

                                @if (!rule.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DeleteRule(rule.Id)">
                                        Löschen
                                    </button>
                                }
                            </div>
                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>
}

@if (activeTab == "imports")

{
<div class="card p-4 mt-4">

    <h3 class="mb-4">
        Importe / Leadquellen
    </h3>

    <div class="border rounded p-3 mb-4">

        <div class="row">

            <div class="col-md-6 mb-3">
                <label>Name der Quelle</label>

                <input class="form-control"
                       placeholder="z. B. Website Formular, Facebook Ads, mobile.de"
                       @bind="newSource.Name" />
            </div>

            <div class="col-md-6 mb-3">
                <label>Quelltyp</label>

                <select class="form-select"
                        @bind="newSource.SourceType">

                    <option value="ApiWebhook">API / Webhook</option>
                    <option value="WebForm">Website Formular</option>
                    <option value="Facebook">Facebook / Meta</option>
                    <option value="Instagram">Instagram</option>
                    <option value="GoogleAds">Google Ads</option>
                    <option value="MobileDe">mobile.de</option>
                    <option value="Csv">CSV Import</option>

                </select>
            </div>

        </div>

        <button class="btn btn-primary"
                @onclick="SaveSource">
            Leadquelle anlegen
        </button>

        @if (!string.IsNullOrWhiteSpace(sourceMessage))
        {
            <div class="alert alert-info mt-3">
                @sourceMessage
            </div>
        }

    </div>

    @if (!sources.Any())
    {
        <p>Noch keine Leadquellen vorhanden.</p>
    }
    else
    {
        <table class="table">

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Typ</th>
                    <th>API-Key</th>
                    <th>Status</th>
                    <th>Aktion</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var source in sources)
                {
                    <tr>
                        <td>@source.Name</td>

                        <td>@source.SourceType</td>

                        <td>
                            <code>@source.ApiKey</code>
                        </td>

                        <td>
                            @if (source.IsActive)
                            {
                                <span class="badge bg-success">Aktiv</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inaktiv</span>
                            }
                        </td>

                        <td>
                            <button class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => ToggleSource(source.Id)">
                                @(source.IsActive ? "Deaktivieren" : "Aktivieren")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    }

</div>
}

@if (activeTab == "mail")
{
    <div class="card p-4 mt-4">

        <h3 class="mb-4">
            Mail-Vorlagen
        </h3>

        <div class="border rounded p-3 mb-4">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label>Name</label>

                    <input class="form-control"
                           placeholder="z. B. Qualifizierungs-Mail"
                           @bind="mailTemplate.Name" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Vorlagentyp</label>

                    <select class="form-select"
                            @bind="mailTemplate.TemplateKey">

                        <option value="QualificationMail">Qualifizierungs-Mail</option>
                        <option value="FollowUp1">Follow-up 1</option>
                        <option value="FollowUp2">Follow-up 2</option>
                        <option value="SalesNotification">Verkäufer-Benachrichtigung</option>

                    </select>
                </div>

            </div>

            <div class="mb-3">
                <label>Betreff</label>

                <input class="form-control"
                       placeholder="Ihre Fahrzeuganfrage"
                       @bind="mailTemplate.Subject" />
            </div>

            <div class="mb-3">
                <label>Inhalt</label>

                <textarea id="lead-template-editor"
                      class="form-control"
                          rows="12">
            </textarea>
            </div>

            <div class="alert alert-light">
                Verfügbare Platzhalter:
                <br />
                <code>{FirstName}</code>
                <code>{LastName}</code>
                <code>{FullName}</code>
                <code>{VehicleTitle}</code>
                <code>{QualificationUrl}</code>
                <code>{CurrentDate}</code>
            </div>

            <button class="btn btn-primary"
                    @onclick="SaveMailTemplate">
                Vorlage speichern
            </button>

            @if (!string.IsNullOrWhiteSpace(templateMessage))
            {
                <div class="alert alert-info mt-3">
                    @templateMessage
                </div>
            }

        </div>

        @if (!mailTemplates.Any())
        {
            <p>Noch keine Mail-Vorlagen vorhanden.</p>
        }
        else
        {
            <table class="table">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Typ</th>
                        <th>Betreff</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var template in mailTemplates)
                    {
                        <tr>
                            <td>@template.Name</td>
                            <td>@template.TemplateKey</td>
                            <td>@template.Subject</td>
                            <td>
                                @if (template.IsActive)
                                {
                                    <span class="badge bg-success">Aktiv</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inaktiv</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        }

    </div>
    
    <div class="card p-4 mt-4">

        <h3 class="mb-4">
            SMTP / Mailversand
        </h3>

        <div class="row">

            <div class="col-md-6 mb-3">
                <label>SMTP Host</label>

                <input class="form-control"
                       @bind="emailSettings.SmtpHost" />
            </div>

            <div class="col-md-3 mb-3">
                <label>Port</label>

                <input type="number"
                       class="form-control"
                       @bind="emailSettings.SmtpPort" />
            </div>

            <div class="col-md-3 mb-3">

                <label>SSL</label>

                <div class="form-check mt-2">

                    <input type="checkbox"
                           class="form-check-input"
                           @bind="emailSettings.UseSsl" />

                    <label class="form-check-label">
                        SSL verwenden
                    </label>

                </div>

            </div>

        </div>

        <div class="row">

            <div class="col-md-6 mb-3">
                <label>SMTP Benutzername</label>

                <input class="form-control"
                       @bind="emailSettings.SmtpUsername" />
            </div>

            <div class="col-md-6 mb-3">
                <label>SMTP Passwort</label>

                <input type="password"
                       class="form-control"
                       @bind="emailSettings.SmtpPassword" />
            </div>

        </div>

        <div class="row">

            <div class="col-md-6 mb-3">
                <label>Absendername</label>

                <input class="form-control"
                       @bind="emailSettings.SenderName" />
            </div>

            <div class="col-md-6 mb-3">
                <label>Absender E-Mail</label>

                <input class="form-control"
                       @bind="emailSettings.SenderEmail" />
            </div>

        </div>

        <button class="btn btn-primary"
                @onclick="SaveEmailSettings">
            Einstellungen speichern
        </button>

        @if (!string.IsNullOrWhiteSpace(emailMessage))
        {
            <div class="alert alert-info mt-3">
                @emailMessage
            </div>
        }

    </div>
}

@if (activeTab == "forms")
{
    <div class="card p-4 mt-4">

        <h3 class="mb-4">
            Formulare
        </h3>

        <div class="border rounded p-3 mb-4">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label>Name</label>

                    <input class="form-control"
                           placeholder="z. B. Standard Qualifizierungsformular"
                           @bind="newForm.Name" />
                </div>
                <div class="col-md-6 mb-3">
                    <label>Öffentlicher Formular-Key</label>

                    <input class="form-control"
                           placeholder="z. B. qualification"
                           @bind="newForm.FormKey" />

                    <small class="text-muted">
                        Öffentliche URL: /lead/form/@newForm.FormKey
                    </small>
                </div>
                <div class="col-md-6 mb-3">
                    <label>Formulartyp</label>

                    <input class="form-control"
                           value="Qualifizierungsformular"
                           readonly />
                </div>

            </div>

            <div class="mb-3">
                <label>Überschrift</label>

                <input class="form-control"
                       @bind="newForm.Headline" />
            </div>

            <div class="mb-3">
                <label>Einleitungstext</label>

                <textarea class="form-control"
                          rows="3"
                          @bind="newForm.IntroText"></textarea>
            </div>

            <div class="mb-3">
                <label>Danke-Text</label>

                <textarea class="form-control"
                          rows="3"
                          @bind="newForm.SuccessText"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary"
                        @onclick="SaveForm">
                    @(editingFormId == null ? "Formular anlegen" : "Änderungen speichern")
                </button>

                @if (editingFormId != null)
                {
                    <button class="btn btn-outline-secondary"
                            @onclick="CancelFormEdit">
                        Abbrechen
                    </button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(formMessage))
            {
                <div class="alert alert-info mt-3">
                    @formMessage
                </div>
            }

        </div>

        @if (!leadForms.Any())
        {
            <p>Noch keine Formulare vorhanden.</p>
        }
        else
        {
            <table class="table">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Key</th>
                        <th>Überschrift</th>
                        <th>Status</th>
                        <th>Aktion</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var form in leadForms)
                    {
                        <tr>
                            <td>@form.Name</td>
                            <td>@form.FormKey</td>
                            <td>@form.Headline</td>
                            <td>
                                @if (form.IsActive)
                                {
                                    <span class="badge bg-success">Aktiv</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inaktiv</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2 flex-wrap">

                                    <a class="btn btn-sm btn-outline-primary"
                                           href="/tools/lead-optimizer/forms/@form.Id">
                                        Felder
                                    </a>

                                    <a class="btn btn-sm btn-outline-secondary"
                                           href="/tools/lead-optimizer/forms/@form.Id/preview"
                                           target="_blank">
                                        Vorschau
                                    </a>

                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => EditForm(form.Id)">
                                        Bearbeiten
                                    </button>

                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => ToggleForm(form.Id)">
                                        @(form.IsActive ? "Deaktivieren" : "Aktivieren")
                                    </button>

                                    @if (!form.IsActive)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => DeleteForm(form.Id)">
                                            Löschen
                                        </button>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        }

    </div>
}
@if (activeTab == "exports")
{
    <div class="card p-4 mt-4">

        <h3 class="mb-4">
            CRM Exporte
        </h3>

        <div class="border rounded p-3 mb-4">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label>Name</label>

                    <input class="form-control"
                           @bind="newExportTarget.Name" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>CATCH E-Mail Adresse</label>

                    <input class="form-control"
                           @bind="newExportTarget.CatchEmailAddress" />
                </div>

                <div class="col-md-4 mb-3">
                    <label>Kampagne</label>

                    <input class="form-control"
                           @bind="newExportTarget.CampaignName" />
                </div>

                <div class="col-md-4 mb-3">
                    <label>Lead Source</label>

                    <input class="form-control"
                           @bind="newExportTarget.LeadSource" />
                </div>

                <div class="col-md-4 mb-3">
                    <label>Lead Channel</label>

                    <input class="form-control"
                           @bind="newExportTarget.LeadChannel" />
                </div>

            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary"
                        @onclick="SaveExportTarget">
                    @(editingExportTargetId == null ? "Exportziel speichern" : "Änderungen speichern")
                </button>

                @if (editingExportTargetId != null)
                {
                    <button class="btn btn-outline-secondary"
                            @onclick="CancelExportTargetEdit">
                        Abbrechen
                    </button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(exportMessage))
            {
                <div class="alert alert-info mt-3">
                    @exportMessage
                </div>
            }

        </div>

        @if (exportTargets.Any())
        {
            <table class="table">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Empfänger</th>
                        <th>Kampagne</th>
                        <th>Status</th>
                        <th>Aktion</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var target in exportTargets)
                    {
                        <tr>

                            <td>@target.Name</td>

                            <td>@target.CatchEmailAddress</td>

                            <td>@target.CampaignName</td>

                            <td>
                                @if (target.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Aktiv
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inaktiv
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2 flex-wrap">
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => EditExportTarget(target.Id)">
                                        Bearbeiten
                                    </button>

                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => ToggleExportTarget(target.Id)">
                                        @(target.IsActive ? "Deaktivieren" : "Aktivieren")
                                    </button>

                                    @if (!target.IsActive)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => DeleteExportTarget(target.Id)">
                                            Löschen
                                        </button>
                                    }
                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }

    </div>

}

@if (activeTab == "logs")
{
    <div class="card p-4 mt-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3>Logs</h3>

            <button class="btn btn-outline-secondary"
                    @onclick="LoadLogs">
                Aktualisieren
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(logMessage))
        {
            <div class="alert alert-info">
                @logMessage
            </div>
        }

        <h4>Export Logs</h4>

        @if (!exportLogs.Any())
        {
            <p>Noch keine Exportlogs vorhanden.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Zeitpunkt</th>
                        <th>Lead</th>
                        <th>Typ</th>
                        <th>Status</th>
                        <th>Antwort</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var log in exportLogs)
                    {
                        <tr>
                            <td>@log.CreatedAt.ToLocalTime()</td>
                            <td>
                                <a href="/tools/lead-optimizer/leads/@log.LeadId">
                                    @log.LeadId
                                </a>
                            </td>
                            <td>@log.ExportType</td>
                            <td>
                                @if (log.Success)
                                {
                                    <span class="badge bg-success">Erfolgreich</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Fehler</span>
                                }
                            </td>
                            <td>
                                <small>@log.ResponseMessage</small>
                            </td>
                        </tr>

                        @if (!string.IsNullOrWhiteSpace(log.RequestPayload))
                        {
                            <tr>
                                <td colspan="5">
                                    <details>
                                        <summary>Payload anzeigen</summary>
                                        <pre class="mt-2"><code>@log.RequestPayload</code></pre>
                                    </details>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }

        <hr />

        <h4>Automation Jobs</h4>

        @if (!automationJobs.Any())
        {
            <p>Noch keine Automation-Jobs vorhanden.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Zeitpunkt</th>
                        <th>Lead</th>
                        <th>Typ</th>
                        <th>Status</th>
                        <th>Retries</th>
                        <th>Fehler</th>
                        <th>Aktion</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var job in automationJobs)
                    {
                        <tr>
                            <td>@job.CreatedAt.ToLocalTime()</td>
                            <td>
                                <a href="/tools/lead-optimizer/leads/@job.LeadId">
                                    @job.LeadId
                                </a>
                            </td>
                            <td>@job.JobType</td>
                            <td>
                                @if (job.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (job.Status == "Failed")
                                {
                                    <span class="badge bg-danger">Failed</span>
                                }
                                else if (job.Status == "Running")
                                {
                                    <span class="badge bg-warning text-dark">Running</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@job.Status</span>
                                }
                            </td>
                            <td>@job.RetryCount</td>
                            <td>
                                <small>@job.ErrorMessage</small>
                            </td>
                            <td>
                                @if (job.Status == "Failed")
                                {
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => RetryAutomationJob(job.Id)">
                                        Retry
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>
}

